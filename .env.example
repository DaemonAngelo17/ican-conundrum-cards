# =============================================================================
# ICAN Conundrum Cards Database — Environment Configuration
# =============================================================================
# Copy this file to `.env.local` and configure ONE of the three live connection
# methods below. If none are configured, the app automatically loads the built-in
# local snapshot (all 84 cards from CON-001 through CON-084) so you can preview
# immediately.
# =============================================================================

# Target Google Spreadsheet ID (defaults to your ICAN Conundrum Cards sheet)
GOOGLE_SHEETS_SPREADSHEET_ID=1OkTnHn6l7dsmJ67GgmebhOH-DLWssIbAMF3iHFlDr3E

# Optional: override tab names if renamed in your sheet
GOOGLE_SHEETS_CONUNDRUM_TAB="Conundrum Database"
GOOGLE_SHEETS_WORKSHEET_TAB="Worksheet Content Database"

# -----------------------------------------------------------------------------
# OPTION A (Recommended for Private Sheets): Google Cloud Service Account
# 1. Create a Service Account in Google Cloud Console & enable Google Sheets API
# 2. Generate a JSON key and share your Google Sheet with the client_email (Viewer)
# 3. Paste client_email and private_key below (keep \n escaped in private_key)
# -----------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_EMAIL=ican-reader@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# OPTION B (Easiest for Link-Shared Sheets): Google Sheets API Key
# 1. Set your sheet sharing to "Anyone with the link -> Viewer"
# 2. Create an API key in Google Cloud Console with Google Sheets API enabled
# -----------------------------------------------------------------------------
# GOOGLE_SHEETS_API_KEY=AIzaSy...

# -----------------------------------------------------------------------------
# OPTION C (Zero GCP Setup): Google Apps Script Web App
# 1. Open Extensions -> Apps Script in your Google Sheet
# 2. Paste the contents of apps-script/Code.gs and Deploy -> Web app (Anyone)
# 3. Paste the deployed Web App URL below
# -----------------------------------------------------------------------------
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# Optional cache TTL in seconds for live sheet responses (default: 300)
SHEETS_CACHE_TTL_SECONDS=300
